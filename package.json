{
  "name": "dsh-mcp-tunnel",
  "version": "0.1.0",
  "description": "DSH plugin: expose a local MCP server to remote agents through an outbound-only tunnel stack (mcp-proxy + cloudflared Quick Tunnel), and register the public URL into dsh-mcp-client streamable-http config.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./lib/*": "./lib/*",
    "./templates/*": "./templates/*",
    "./cordis.yml": "./cordis.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "templates",
    "tests",
    "cordis.yml",
    "README.md",
    "LICENSE",
    "docs/store-evidence.md"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "test": "node --test tests/tunnel.smoke.ts tests/tunnel.e2e.ts",
    "test:smoke": "node --test tests/tunnel.smoke.ts",
    "test:e2e": "DSH_MCP_TUNNEL_E2E=1 node --test tests/tunnel.e2e.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "compatibility": {
      "node": ">=23.6.0",
      "dsh": ">=0.1.0"
    },
    "permissions": {
      "summary": "把本机 MCP server 经出站-only 隧道栈暴露给远程 agent：mcp-proxy + cloudflared Quick Tunnel 的 Docker Compose 栈；公开 URL 注册进 dsh-mcp-client streamable-http 配置。用户可选择不建真实隧道。",
      "commands": [
        "docker compose up -d --build (compose project, non-shell spawn)",
        "docker ps",
        "docker logs --tail <n>",
        "docker compose down",
        "<dockerBinary> --version (preflight)"
      ],
      "writePaths": [
        "<deployRoot>/<name>/** (compose/.env/state.json/证书)"
      ],
      "externalServices": [
        "Cloudflare Quick Tunnel 出站端点（默认仅在用户触发 create 时建立）"
      ],
      "failureBoundaries": [
        "preflight 8s 超时",
        "OUT_OF_BOUNDS 根约束",
        "state.json 记录下线+lastError"
      ],
      "lifecycleEvidence": [
        "smoke 18 assertions + certs/state 测试",
        "真实隧道默认不建（LIVE 才建）"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@types/node": "^26.0.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/988hj7tczd-oss/dsh-mcp-tunnel.git"
  }
}
